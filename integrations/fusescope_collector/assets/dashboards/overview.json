    "panels": {
      "e51ad74c-cbf5-5f18-839c-8706999e4813": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Accepted by receiver",
            "description": "Items each receiver accepted, per second."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "short",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": 0,
                "softMax": 0,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "promql",
                        "spec": {
                          "name": "A",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_spans{\"service.name\"=\"fusescope-collector\"}[5m]))",
                          "legend": "{receiver} spans",
                          "disabled": false
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "B",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_log_records{\"service.name\"=\"fusescope-collector\"}[5m]))",
                          "legend": "{receiver} log_records",
                          "disabled": false
                        }
                      },
                      {
                        "type": "promql",
                        "spec": {
                          "name": "C",
                          "query": "sum by (receiver) (rate(otelcol_receiver_accepted_metric_points{\"service.name\"=\"fusescope-collector\"}[5m]))",
                          "legend": "{receiver} metric_points",
                          "disabled": false
                        }
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
